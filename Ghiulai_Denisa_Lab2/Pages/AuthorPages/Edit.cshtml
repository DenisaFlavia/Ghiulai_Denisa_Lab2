
@page
@model Ghiulai_Denisa_Lab2.Pages.AuthorPages.EditModel

@{
    ViewData["Title"] = "Edit Author";
}

<h1>Edit Author</h1>

<hr />

<div class="row">
    <div class="col-md-4">
        <form method="post">
            <input type="hidden" asp-for="Author.ID" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Author.FirstName"></label>
                <input asp-for="Author.FirstName"
                       class="form-control" />
                <span asp-validation-for="Author.FirstName"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Author.LastName"></label>
                <input asp-for="Author.LastName"
                       class="form-control" />
                <span asp-validation-for="Author.LastName"
                      class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit"
                       value="Save"
                       class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
