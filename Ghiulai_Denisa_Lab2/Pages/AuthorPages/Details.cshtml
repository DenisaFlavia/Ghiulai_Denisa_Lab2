
@page
@model Ghiulai_Denisa_Lab2.Pages.AuthorPages.DetailsModel

@{
    ViewData["Title"] = "Details Author";
}

<h1>Details</h1>

<div>
    <h4>Author</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">First Name</dt>
        <dd class="col-sm-10">
            @Model.Author.FirstName
        </dd>

        <dt class="col-sm-2">Last Name</dt>
        <dd class="col-sm-10">
            @Model.Author.LastName
        </dd>
    </dl>
</div>

<div>
    <a asp-page="./Edit"
       asp-route-id="@Model.Author.ID">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
