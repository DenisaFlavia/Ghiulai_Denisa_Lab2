@page "/"
@model Ghiulai_Denisa_Lab2.Pages.BookPages.IndexModel

@{
    ViewData["Title"] = "Books";
}

<h1>Index</h1>

<p>
    <a asp-page="./Create">Create New</a>
</p>

<form asp-page="./Index" method="get">
    <div class="form-actions no-color">
        <p>
            Find by Book Title / Author Name:

            <input type="text"
                   name="searchString"
                   value="@Model.CurrentFilter" />

            <input type="submit"
                   value="Search"
                   class="btn btn-primary" /> |

            <a asp-page="./Index">Back to full List</a>
        </p>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>
                <a asp-page="./Index"
                   asp-route-sortOrder="@Model.TitleSort">
                    Book Title
                </a>
            </th>

            <th>
                <a asp-page="./Index"
                   asp-route-sortOrder="@Model.AuthorSort">
                    Author
                </a>
            </th>

            <th>Price</th>
            <th>Publishing Date</th>
            <th>Publisher</th>
            <th>Categories</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.BookD.Books)
        {
            string selectedRow = "";

            if (item.ID == Model.BookID)
            {
                selectedRow = "table-success";
            }

            <tr class="@selectedRow">
                <td>
                    @Html.DisplayFor(modelItem => item.Title)
                </td>

                <td>
                    @if (item.AuthorNavigation != null)
                    {
                        @item.AuthorNavigation.FullName
                    }
                    else
                    {
                        <text>No author assigned</text>
                    }
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Price)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.PublishingDate)
                </td>

                <td>
                    @item.Publisher?.PublisherName
                </td>

                <td>
                    @if (item.BookCategories != null)
                    {
                        foreach (var category in item.BookCategories)
                        {
                            if (category.Category != null)
                            {
                                <div>
                                    @category.Category.ID
                                    @category.Category.CategoryName
                                </div>
                            }
                        }
                    }
                </td>

                <td>
                    <a asp-page="./Edit"
                       asp-route-id="@item.ID">Edit</a> |

                    <a asp-page="./Details"
                       asp-route-id="@item.ID">Details</a> |

                    <a asp-page="./Delete"
                       asp-route-id="@item.ID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
